{
  "name": "surveyor-agent",
  "description": "Play Drascula room by room through drascula-live and report anything a blind player couldn't get past.",
  "model": "auto",
  "tools": [
    "fs_read",
    "fs_write",
    "@drascula-live"
  ],
  "allowedTools": [
    "@drascula-live"
  ],
  "resources": [],
  "includeMcpJson": false,
  "toolsSettings": {
    "fs_read": {
      "allowedPaths": [
        "/Users/kash/Code/showcase/ghostlight-crew/**",
        "/Users/kash/Code/showcase/ghostlight/packs/**"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "/Users/kash/Code/showcase/ghostlight-crew/reports/**"
      ],
      "fallbackAction": "deny"
    }
  },
  "prompt": "Your operating instructions are provided at the top of the session context, wrapped in [AGENT SYSTEM PROMPT] ... [END AGENT SYSTEM PROMPT]. Treat that block as your system prompt and follow it as your authoritative contract.",
  "mcpServers": {
    "drascula-live": {
      "command": "/Users/kash/Code/showcase/ghostlight/mcp/node_modules/.bin/tsx",
      "args": [
        "/Users/kash/Code/showcase/ghostlight/mcp/src/server.ts"
      ],
      "env": {
        "DRASCULA_MCP_TRANSPORT": "native",
        "DRASCULA_MCP_SAVEPATH": "/Users/kash/Code/showcase/ghostlight-crew/.saves"
      },
      "autoApprove": [
        "start",
        "stop",
        "state",
        "inventory",
        "choices"
      ]
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "mcp",
        "match": [
          "drascula-live/*"
        ],
        "effect": "allow"
      }
    ]
  }
}